# Cloudflare Workers local secrets & environment variables
# Copy this file to `.dev.vars` and fill in your values.
# NEVER commit `.dev.vars` to git.
# For production, upload secrets with: `bunx wrangler secret put <KEY>`

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_string

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_or_service_role_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_publishable_or_anon_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# --- Federation / Chat IDs ---
OWNER_ID=123456789
PROOFS=-1001234567890
MAIN_GROUP=-1001234567890
MAIN_CHANNEL=-1001234567890
LOGS=-1001234567890
LOGS_ERRORS=-1001234567890
APPEALS=-1001234567890
INFRA_CHAT_IDS=

# --- Optional Observability ---
SENTRY_DSN=
